+// RunForwardDaemon 独立转发器主循环(kunpanel fwd):每 15s 重读端口清单
+// 纳入新增端口(只增不减,避免误断现网流量),直到收到停止信号。
+func RunForwardDaemon(stop <-chan struct{}) error {
+	for {
+		select {
+		case <-stop:
+			return nil
+		default:
+		}
+		for _, port := range loadProxyPorts() {
+			registerQuiet(port)
+		}
+		select {
+		case <-stop:
+			return nil
+		case <-time.After(15 * time.Second):
+		}
